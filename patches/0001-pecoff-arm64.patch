index 0000000..e986d74
--- /dev/null
+++ b/substratevm/src/com.oracle.objectfile/src/com/oracle/objectfile/pecoff/AArch64InlineAddend.java
@@ -0,0 +1,62 @@
+/*
+ * Encodes the addend of an ARM64 Coff relocation into the relocated instruction's immediate, where
+ * the linkers read it (Coff has no explicit addends).
+ */
+package com.oracle.objectfile.pecoff;
+
+import com.oracle.objectfile.ObjectFile.RelocationKind;
+
+final class AArch64InlineAddend {
+    private AArch64InlineAddend() {
+    }
+
+    static boolean isInstruction(RelocationKind k) {
+        return switch (k) {
+            case AARCH64_R_AARCH64_ADR_PREL_PG_HI21, AARCH64_R_AARCH64_ADD_ABS_LO12_NC, AARCH64_R_AARCH64_LDST128_ABS_LO12_NC, AARCH64_R_AARCH64_LDST64_ABS_LO12_NC,
+                            AARCH64_R_AARCH64_LDST32_ABS_LO12_NC, AARCH64_R_AARCH64_LDST16_ABS_LO12_NC, AARCH64_R_AARCH64_LDST8_ABS_LO12_NC, AARCH64_R_LD_PREL_LO19 ->
+                true;
+            default -> false;
+        };
+    }
+
+    static int encode(RelocationKind k, int instruction, long addend) {
+        return switch (k) {
+            // ADRP: the addend in bytes, as a signed 21-bit immediate (immhi:immlo)
+            case AARCH64_R_AARCH64_ADR_PREL_PG_HI21 -> {
+                check(addend >= -(1L << 20) && addend < (1L << 20), k, addend);
+                int imm = (int) addend;
+                yield (instruction & ~((0x3 << 29) | (0x7FFFF << 5))) | ((imm & 0x3) << 29) | (((imm >> 2) & 0x7FFFF) << 5);
+            }
+            // ADD: the addend's page offset, unscaled
+            case AARCH64_R_AARCH64_ADD_ABS_LO12_NC -> imm12(instruction, addend & 0xFFF);
+            // LDR/STR: the addend's page offset, scaled by the access size
+            case AARCH64_R_AARCH64_LDST128_ABS_LO12_NC -> scaled(k, instruction, addend, 4);
+            case AARCH64_R_AARCH64_LDST64_ABS_LO12_NC -> scaled(k, instruction, addend, 3);
+            case AARCH64_R_AARCH64_LDST32_ABS_LO12_NC -> scaled(k, instruction, addend, 2);
+            case AARCH64_R_AARCH64_LDST16_ABS_LO12_NC -> scaled(k, instruction, addend, 1);
+            case AARCH64_R_AARCH64_LDST8_ABS_LO12_NC -> scaled(k, instruction, addend, 0);
+            // LDR (literal): the linkers OR the offset into the instruction, with no addend
+            case AARCH64_R_LD_PREL_LO19 -> {
+                check(addend == 0, k, addend);
+                yield instruction & ~(0x7FFFF << 5);
+            }
+            default -> throw new IllegalArgumentException("Not an ARM64 instruction relocation: " + k);
+        };
+    }
+
+    private static int scaled(RelocationKind k, int instruction, long addend, int shift) {
+        long offset = addend & 0xFFF;
+        check((offset & ((1L << shift) - 1)) == 0, k, addend);
+        return imm12(instruction, offset >> shift);
+    }
+
+    private static int imm12(int instruction, long imm) {
+        return (instruction & ~(0xFFF << 10)) | ((int) imm << 10);
+    }
+
+    private static void check(boolean condition, RelocationKind k, long addend) {
+        if (!condition) {
+            throw new IllegalArgumentException("Addend " + addend + " can't be encoded in a PECoff ARM64 " + k + " relocation");
+        }
+    }
+}
