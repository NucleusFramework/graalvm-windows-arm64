+    @BasedOnJDKClass(jdk.internal.foreign.abi.aarch64.windows.WindowsAArch64Linker.class)
+    @BasedOnJDKClass(jdk.internal.foreign.abi.aarch64.windows.WindowsAArch64CallArranger.class)
+    @SingletonTraits(access = AllAccess.class, layeredCallbacks = NoLayeredCallbacks.class, layeredInstallationKind = Duplicable.class)
+    static final class WindowsAArch64 extends ARM64 {
+
+        @Override
+        protected CallingSequence makeCallingSequence(MethodType type, FunctionDescriptor desc, boolean forUpcall, LinkerOptions options) {
+            return jdk.internal.foreign.abi.aarch64.CallArranger.WINDOWS.getBindings(type, desc, forUpcall, options).callingSequence();
+        }
+
+        @Override
+        public void checkLibrarySupport() {
+            VMError.guarantee(ForeignFunctionsRuntime.isLibcSupported(), REQUIRES_LIB_C_SUPPORT);
+            VMError.guarantee(ForeignFunctionsRuntime.isWindowsApiSupported(), "Capturing call state requires Windows API support");
+        }
+
+        /**
+         * The Windows ARM64 ABI passes variadic floating-point arguments in general purpose
+         * registers: reinterpret them as longs (as {@code Win64} does for its register copies).
+         */
+        @Override
+        @Platforms(Platform.HOSTED_ONLY.class)
+        protected List<Adapter.Adaptation> generateAdaptations(NativeEntryPointInfo nep) {
+            List<Adapter.Adaptation> adaptations = super.generateAdaptations(nep);
+            for (int i = 0; i < adaptations.size(); i++) {
+                Class<?> type = nep.methodType().parameterType(i);
+                if ((type == float.class || type == double.class) && nep.parametersAssignment()[i].type() == AArch64Architecture.StorageType.INTEGER) {
+                    assert adaptations.get(i) == null;
+                    adaptations.set(i, Adapter.reinterpret(JavaKind.Long));
+                }
+            }
+            return adaptations;
+        }
+    }
