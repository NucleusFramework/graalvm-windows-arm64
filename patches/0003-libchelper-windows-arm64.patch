+/*
+ * The corresponding HotSpot code can be found in vm_version_windows_aarch64.cpp.
+ */
+#include <windows.h>
+#include "aarch64cpufeatures.h"
+
+void determineCPUFeatures(CPUFeatures* features) {
+  memset(features, 0, sizeof(CPUFeatures));
+  // ARMv8 requires FP and ASIMD
+  features->fFP = 1;
+  features->fASIMD = 1;
+  if (IsProcessorFeaturePresent(PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE)) {
+    features->fAES = 1;
+    features->fPMULL = 1;
+    features->fSHA1 = 1;
+    features->fSHA2 = 1;
+  }
+  features->fCRC32 = !!IsProcessorFeaturePresent(PF_ARM_V8_CRC32_INSTRUCTIONS_AVAILABLE);
+  features->fLSE = !!IsProcessorFeaturePresent(PF_ARM_V81_ATOMIC_INSTRUCTIONS_AVAILABLE);
+#ifdef PF_ARM_SVE_INSTRUCTIONS_AVAILABLE
+  features->fSVE = !!IsProcessorFeaturePresent(PF_ARM_SVE_INSTRUCTIONS_AVAILABLE);
+#endif
+#ifdef PF_ARM_SVE2_INSTRUCTIONS_AVAILABLE
+  features->fSVE2 = !!IsProcessorFeaturePresent(PF_ARM_SVE2_INSTRUCTIONS_AVAILABLE);
+#endif
+#ifdef PF_ARM_SVE_BITPERM_INSTRUCTIONS_AVAILABLE
+  features->fSVEBITPERM = !!IsProcessorFeaturePresent(PF_ARM_SVE_BITPERM_INSTRUCTIONS_AVAILABLE);
+#endif
+#ifdef PF_ARM_SHA3_INSTRUCTIONS_AVAILABLE
+  features->fSHA3 = !!IsProcessorFeaturePresent(PF_ARM_SHA3_INSTRUCTIONS_AVAILABLE);
+#endif
+#ifdef PF_ARM_SHA512_INSTRUCTIONS_AVAILABLE
+  features->fSHA512 = !!IsProcessorFeaturePresent(PF_ARM_SHA512_INSTRUCTIONS_AVAILABLE);
+#endif
+}
